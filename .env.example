# Copy to .env for local overrides. Do not put production secrets in this file.
# The values below are for the local Docker database only.

DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=credit_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=credit_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Set this to use one URL instead of the POSTGRES_* parts.
# Render sets DATABASE_URL from the Blueprint database.
# DATABASE_URL=postgres://postgres:credit_dev_password@db:5432/credit_db

# Local docker-compose defaults to a real Redis broker.
# The Render Blueprint sets CELERY_TASK_ALWAYS_EAGER=true and does not set a broker.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# if-empty | always | false
SEED_ON_START=if-empty

# Render injects PORT. Local Docker uses 8000.
# PORT=8000
WEB_CONCURRENCY=1
